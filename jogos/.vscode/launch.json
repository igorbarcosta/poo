            "request": "launch",
            "name": "Meu jogo",
            "mainClass": "meujogo.Iniciar",
            "projectName": "meu-jogo",
            "cwd": "${workspaceFolder}",
            "vmArgs": "--enable-native-access=ALL-UNNAMED",
            "osx": {
                "vmArgs": "--enable-native-access=ALL-UNNAMED -XstartOnFirstThread"
            }
        },
        {
            "type": "java",
            "request": "launch",
            "name": "Exemplo Megamania",
            "mainClass": "br.edu.ifpb.jogos.megamania.IniciarMegamania",
            "projectName": "exemplo-megamania",
            "cwd": "${workspaceFolder}",
            "vmArgs": "--enable-native-access=ALL-UNNAMED",
            "osx": {
                "vmArgs": "--enable-native-access=ALL-UNNAMED -XstartOnFirstThread"
            }
        }
    ]
}
